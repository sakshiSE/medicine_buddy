# Free Tavily key (needed for full India-first live brand and ingredient discovery)
# Create at https://app.tavily.com/ . Never enable pay-as-you-go.
TAVILY_API_KEY=

# Optional. No database is required for the starter build.
# DATABASE_URL=

# Optional CORS override for local development. Vercel same-origin deploy needs none.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GROQ_API_KEY=your_actual_groq_key
GEMINI_API_KEY=your_actual_gemini_key

GROQ_MODEL=
GEMINI_MODEL=
